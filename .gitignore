# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
credentials*
*.netrc

# ---------------------------------------------------------------------------
# Datasets.
# MovieLens (GroupLens) and IMDb data may NOT be redistributed. Download them
# from the original sources instead - see README.md.
# ---------------------------------------------------------------------------
data/
dataset/*
datasets/
ml-1m/
ml-10m/
ml-20m/
ml-32m/
new-ml-32m-dataset/
generated/

# RecBole atomic files and raw MovieLens/IMDb tables
*.inter
*.item
*.user
*.kg
*.link
*.dat
ratings.csv
movies.csv
links.csv
tags.csv
genome-*.csv
*.tsv
*.tsv.gz

# ---------------------------------------------------------------------------
# Model weights, checkpoints and cached tensors
# ---------------------------------------------------------------------------
saved/
finetuned/
p5-ckpt-*/
p5-ml32m/
p5-ml32m-ckpt/
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.h5
*.onnx
*.npz
*.npy
*.pkl
*.pickle
*.joblib
*.zip
*.tar
*.tar.gz
*.gz

# ---------------------------------------------------------------------------
# Logs and run outputs
# ---------------------------------------------------------------------------
log/
log_tensorboard/
logs/
*.log
runs/
wandb/
llm_rating_results/

# ---------------------------------------------------------------------------
# Generated figures and bulk result tables
# ---------------------------------------------------------------------------
figures/
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.csv
*.json

# ---------------------------------------------------------------------------
# dataset/ml-32m/ is tracked with Git LFS (see .gitattributes). These rules come
# last so they override the dataset/, file-type and *.csv rules above. Exact duplicates stay out.
# ---------------------------------------------------------------------------
!dataset/ml-32m/
!dataset/ml-32m/*
dataset/ml-32m/ml-32m_tab.inter
dataset/ml-32m/*.bak
